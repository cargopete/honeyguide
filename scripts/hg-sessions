#!/usr/bin/env python3
"""List the ask sessions logged under ~/.honeyguide/sessions (or $HG_LOG_DIR).

Newest last, one line per session, so the corpus can be read without opening
anything. `--full <file>` prints one session's turns in order.
"""
import json
import os
import sys
from pathlib import Path

LOGS = Path(os.environ.get("HG_LOG_DIR", Path.home() / ".honeyguide" / "sessions"))


def records(path):
    for line in path.read_text(errors="replace").splitlines():
        try:
            yield json.loads(line)
        except ValueError:
            continue


def summarise(path):
    head = res = None
    for r in records(path):
        if r.get("kind") in ("ask", "task"):
            head = head or r
        elif r.get("kind") == "result":
            res = r
    if not head:
        return None
    if not res:
        return f"{path.name[:15]}  {'RUNNING':<10}  {head.get('question', '')[:60]}"
    verdict = ("grounded" if res.get("grounded")
               else "declined" if res.get("declined") else "NO ANSWER")
    return (f"{path.name[:15]}  {verdict:<10}  {res['turns']:>2}t "
            f"{res['wall_s']:>6.1f}s  {'forced ' if res.get('forced') else '       '}"
            f"{head.get('question', '')[:60]}")


def main():
    if not LOGS.is_dir():
        print(f"no sessions yet: {LOGS} does not exist")
        return 0
    if len(sys.argv) > 2 and sys.argv[1] == "--full":
        for r in records(Path(sys.argv[2])):
            if r.get("kind") == "turn" and r.get("action"):
                a = r["action"]
                print(f"[{r['turn']}] {a.get('tool')}: {a.get('reasoning', '')[:100]}")
                print(f"     -> {(r.get('obs') or 'ANSWERED').splitlines()[0][:110]}")
            elif r.get("kind") == "result":
                print(f"\n{r.get('answer') or r.get('ungrounded_attempt') or '(no answer)'}")
        return 0
    for f in sorted(LOGS.glob("*.jsonl")):
        line = summarise(f)
        if line:
            print(line)
    return 0


if __name__ == "__main__":
    sys.exit(main())
