#!/bin/sh
# Ask a question about the repository you are standing in.
#
#     scripts/hg-ask "what does the piece picker do?"
#     HG_REPO=~/src/dipper scripts/hg-ask "how do you write to the index?"
#
# Read-only: this mode has no edit tool and no way to write a file, so it is
# safe to run against a tree with uncommitted work in it. There is no compile
# gate on an answer, only the grounding check described in RFC-0001 §5, so read
# the citations rather than the prose.
set -eu
here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

# -c carries the previous questions and answers for this repository into the new
# one, so a follow-up does not have to restate what it is following up on.
#
# -f FILE attaches a file's text to the question, and piped stdin does the same.
# Use one of those for anything containing backticks or $(...): inside a quoted
# shell argument the shell runs those before honeyguide sees them.
opts=""
while :; do
    case "${1:-}" in
        -c|--continue)  opts="$opts --continue"; shift ;;
        -f|--attach)    opts="$opts --attach $2"; shift 2 ;;
        *)              break ;;
    esac
done

exec python3 "$here/../m0/spike.py" --repo "${HG_REPO:-$PWD}" $opts --ask "$*"
